# bbh.toml.example — copy to your consumer root as bbh.toml. Every key is
# optional; the value shown is the DEFAULT (docs/config.md has the meaning
# and the origin of each). Regexes go in 'literal strings'.

[project]
root = "."
gates_dir = "tests"
gate_glob = "*.sh"
lib_dir = "tests/lib"
runner_prefixes = ["run_"]
manual_suffixes = ["_soak"]
tools_dir = "tools"
shadow_link_dirs = ["build", "tests", "docs"]
instrument_word = "emulator"

[registries]
portable = "tests/ci_portable.txt"
static = "tests/ci_static.txt"
sweep = "tests/ci_emulator.tsv"
static_needs_env = "ROMDIR"

[tier]
patterns = ['run_(replay_)?(mame|fbneo)\.sh', 'run_replay_guarded\.sh',
            'MAME_BIN', 'FBNEO_BIN', 'autoboot_script', 'emu/fbneo/fbneo',
            'run_battery', 'run_sim_jtcps2\.sh',
            'run_inp_probe\.sh', 'run_inp_guarded\.sh']
source_regex = '^\s*\.\s+"?\$(?:REPO|\{REPO\})"?/(tests/lib/[a-z0-9_]+\.sh)'
source_depth = 2

[classify]
skip_regex = '^ *SKIP'
shell_error_regex = '\.sh: line [0-9]+: [A-Za-z_][A-Za-z0-9_]*: '
timeout_exits = [124, 137]
fail_tail = 4

[thresholds]
flicker_max = 2
reconverge = 60
flicker_max_total = 8

[suite]
replays_dir = "tests/replays"
expected_dir = "tests/expected"
mask_default = "043c-043d,4182-41a2,7f00-8000"
# --- slice H3: the suite runner and the fingerprint ---
registry = "tests/expected/registry.tsv"   # sha1 <TAB> expectation-set <TAB> notes; rows only at freeze time
default_set = "vsavj"                      # the set run when none is named
driver = "tools/run_replay_mame.sh"        # a path from the root, or a bare harness driver name (drivers/<name>.sh)
runs_per_replay = 2                        # any difference between runs = NONDETERMINISTIC
mask_env = "MASK_RANGES"                   # the variable the driver reads the mask from
rompath_env = "MAME_ROMPATH"               # the driver's search-path variable (falls back to input_env)
input_env = "ROMDIR"                       # the reference-input directory, demanded at the entrance
hermetic_unset = ["POKES", "DUMPS", "SNAP_FRAMES", "TAIL_FRAMES", "VIDEO_OUT",
                  "INPUT_OUT", "INPUT_INJECT_TEST", "NO_INPUT_CHECK"]
hash_cmd = "shasum"                        # prints "<hex> <file>"; sha1sum on Linux

[fingerprint]
kind = "zip-members"                       # zip-members | file-sha1 | command
program_member_regex = '\.(0[3-9]|10|4[1-4])[a-ln-z]?$'   # group 1 = the member's ORDER (an integer)
parent_sets = ["vsav"]                     # images --full folds in along the search path (a clone's parent)
region_rules = [['\.key$', 'key'], ['\.0[12]$', 'z80'], ['^vsw\..*m$', 'gfx/qsnd'],
                ['^vsw\.', 'prg'], ['@program', 'prg']]   # --full's breakdown; first match wins; @program = the regex above
region_default = "gfx/qsnd"
file_pattern = "{set}.bin"                 # kind file-sha1: the image's file name
program_command = ""                       # kind command: prints the program key ({rompath}, {set} substituted)
wholeset_command = ""                      # kind command: prints the whole-set key
