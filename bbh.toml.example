# bbh.toml.example — copy to your consumer root as bbh.toml. Every key is
# optional; the value shown is the DEFAULT (docs/config.md has the meaning
# and the origin of each). Regexes go in 'literal strings'.

[project]
root = "."
gates_dir = "tests"
gate_glob = "*.sh"
lib_dir = "tests/lib"
runner_prefixes = ["run_"]
manual_suffixes = ["_soak"]
tools_dir = "tools"
shadow_link_dirs = ["build", "tests", "docs"]
instrument_word = "emulator"

[registries]
portable = "tests/ci_portable.txt"
static = "tests/ci_static.txt"
sweep = "tests/ci_emulator.tsv"
static_needs_env = "ROMDIR"

[tier]
patterns = ['run_(replay_)?(mame|fbneo)\.sh', 'run_replay_guarded\.sh',
            'MAME_BIN', 'FBNEO_BIN', 'autoboot_script', 'emu/fbneo/fbneo',
            'run_battery', 'run_sim_jtcps2\.sh',
            'run_inp_probe\.sh', 'run_inp_guarded\.sh']
source_regex = '^\s*\.\s+"?\$(?:REPO|\{REPO\})"?/(tests/lib/[a-z0-9_]+\.sh)'
source_depth = 2

[classify]
skip_regex = '^ *SKIP'
shell_error_regex = '\.sh: line [0-9]+: [A-Za-z_][A-Za-z0-9_]*: '
timeout_exits = [124, 137]
fail_tail = 4

[thresholds]
flicker_max = 2
reconverge = 60
flicker_max_total = 8

[suite]
replays_dir = "tests/replays"
expected_dir = "tests/expected"
mask_default = "043c-043d,4182-41a2,7f00-8000"
# --- slice H3: the suite runner and the fingerprint ---
registry = "tests/expected/registry.tsv"   # sha1 <TAB> expectation-set <TAB> notes; rows only at freeze time
default_set = "vsavj"                      # the set run when none is named
driver = "tools/run_replay_mame.sh"        # a path from the root, or a bare harness driver name (drivers/<name>.sh)
runs_per_replay = 2                        # any difference between runs = NONDETERMINISTIC
mask_env = "MASK_RANGES"                   # the variable the driver reads the mask from
rompath_env = "MAME_ROMPATH"               # the driver's search-path variable (falls back to input_env)
input_env = "ROMDIR"                       # the reference-input directory, demanded at the entrance
hermetic_unset = ["POKES", "DUMPS", "SNAP_FRAMES", "TAIL_FRAMES", "VIDEO_OUT",
                  "INPUT_OUT", "INPUT_INJECT_TEST", "NO_INPUT_CHECK"]
hash_cmd = "shasum"                        # prints "<hex> <file>"; sha1sum on Linux

[fingerprint]
kind = "zip-members"                       # zip-members | file-sha1 | command
program_member_regex = '\.(0[3-9]|10|4[1-4])[a-ln-z]?$'   # group 1 = the member's ORDER (an integer)
parent_sets = ["vsav"]                     # images --full folds in along the search path (a clone's parent)
region_rules = [['\.key$', 'key'], ['\.0[12]$', 'z80'], ['^vsw\..*m$', 'gfx/qsnd'],
                ['^vsw\.', 'prg'], ['@program', 'prg']]   # --full's breakdown; first match wins; @program = the regex above
region_default = "gfx/qsnd"
file_pattern = "{set}.bin"                 # kind file-sha1: the image's file name
program_command = ""                       # kind command: prints the program key ({rompath}, {set} substituted)
wholeset_command = ""                      # kind command: prints the whole-set key

[sweep]
# the instrument-tier sweep (bbh run-sweep); every value = the lineage's (docs/config.md [sweep])
lanes = ["prereq", "fbneo", "mame", "mister"]       # every lane, in run order
default_lanes = ["prereq", "fbneo", "mame"]         # with no --lane
prereq_lane = "prereq"
release_scope = "release"
cadences = ["romset", "bitstream"]
freeze_cadence = "romset"
cadence_drop_note = ["These follow the .rbf, not the romset (ruled 2026-09-03). A",
                     "RELEASE always runs them; this run does not.",
                     ">> IS THIS FREEZE TARGETING MiSTer? If yes, re-run with",
                     "   --cadence all --lane mister. If no, this is correct."]
default_timeout = 5400
precondition = 'python3 tools/audit_roms.py "$ROMDIR" > /dev/null'
precondition_fail_text = "ROM audit FAILED — stop (CLAUDE.md §3)"
input_env = "ROMDIR"
log_dir_prefix = "build/emu_sweep_"
placeholders = { MERGED = "build/m3b_merged23", DON = "build/don_m20", HUI = "build/hui54", PYR = "build/pyron38", STOCK = "build/m5_stock15" }
rompath_placeholder_suffix = "_RP"
rompath_suffix = "/rompath"
build_sets = ["vsavjw", "vsavj"]
instruments = [["mame-wide", "MAME_WIDE_BIN", "$HOME/.cache/vampire-saved/mame/cps2"],
               ["mame-ref", "MAME_REF_BIN", "$HOME/.cache/vampire-saved/mame-ref/cps2"],
               ["fbneo", "", "$REPO/emu/fbneo/fbneo"]]
env_defaults = [["MAME_BIN", "mame-wide"]]
scratch_lanes = ["mister"]
scratch_env = "JTSIM_SCRATCH"
scratch_default = "vampire-saved-jtsim"
prereq_cite = "[CPE-24]"

# --- slice H5: expectation and gate hygiene (docs/hygiene.md; every value = the lineage's) ---
[gate_header]
title_sep_regex = '\s*[—–-]+\s*'
session_regex = '\b(14z-\d+[a-z]?(?:\s*\(\d+\))?|M[0-9][a-z]?\b|session \d+[a-z]?|20\d\d-\d\d-\d\d)'
duration_regex = '~\s*(\d+(?:\.\d+)?)\s*(min|s\b|sec|h\b|hours?)'
index_out = "docs/project/gate_index.md"            # the GENERATED index (bbh gate-index; --check in a gate)
families_tsv = "tests/gate_index.tsv"               # gate <TAB> family [<TAB> needs] [<TAB> since] — the one hand-maintained input
families = [["runner", "the suite runners and their own ground truth"],
            ["docs", "the documentation locks — docs, skills, indexes, tables follow the tree"],
            ["platform", "the emulators and the ROM images as instruments — builds, decrypt, replay determinism, harness hygiene"],
            ["pipeline", "the build pipeline — manifests, patch ops, extraction/reconciliation/generation law, static censuses"],
            ["oracle", "the CLAUDE.md §4 oracle classes — masked legacy, flicker/window/composite, dual-track, the recording corpus"],
            ["gfx", "tiles, OBJ records, sprite lists, render-layer verdicts"],
            ["tenant", "tenant content — per-character gates and on-demand audits on the ported characters"],
            ["character-data", "the character-data map — move naming, hitboxes, reactions, projectiles, measured mechanics"],
            ["review-triage", "the 14z-94 adversarial-review closures (GitHub #74's index) — every one a guard the review asked for"],
            ["mister", "the MiSTer lane — the jtcps2w core, the simulation oracles, MRA/.rom generation"]]
kinds = [["audit_", "audit"], ["run_", "run"]]      # name prefix -> kind; else "test"
needs_instruments = [["verilator", "Verilator"], ["jtsim", "Verilator"], ["simulator", "Verilator"],
                     ["mame", "MAME"], ["fbneo", "FBNeo"]]   # header keyword -> the instrument in a derived `needs`
needs_build_regex = 'build/\w|build dir|builddir|<build>'
index_preamble = ["# The gate index (GENERATED)", "", "<!-- generated by tools/gen_gate_index.py — do not edit; regenerate -->"]   # the consumer's opening lines (the default carries the lineage's whole paragraph)

[header_defaults]
token_regex = 'build/[A-Za-z0-9_]+'                 # what a path default looks like
claim_line_regex = 'usage\s*:|defaults?\b'          # only a Usage/default line is checked
verbatim_regex = '\(verbatim[;,)]'                  # opens an exempt ARCHIVE block
root_prefix_regex = '(?:\$\{?REPO\}?/)?'

[ref_rot]
token_regex = 'build/[a-z0-9_]+'                    # the default's shape in CODE
root_prefix_regex = '(?:\$\{?REPO\}?/)?'
rompath_suffix = "/rompath"                         # judged only when the script reads $VAR/rompath ("" = the dir is the image dir)
image_glob = "*.zip"
image_prefer = ["vsavjw", "vsavj"]                  # substrings, in order; else the first by name
stale_marker = ["vsw.", "vsw.z01", "no vsw.z01 (pre-WIDE v1.1)"]   # [member prefix, required member, reason]
predicate = ""                                      # or a command: $1 = the image; prints its description; exit 0 live / 1 rotted
family_regex = '^([a-z]+)-m(\d+)$'                  # registry set name -> (family, generation) for the currency report
no_row_note = "no registry row (by design for the blanks instrument; a merged build has one since B2; else a pre-freeze build)"
rotted_advice = ["A rotted default means the script cannot run at all: it dies before",
                 "measuring anything, and it says so only when somebody runs it.",
                 "Re-point it at a current build, or parameterise it the way",
                 "audit_merged_legacy.sh's leg (b) was at 14z-94."]

[provenance]
page = "tests/expected/PROVENANCE.md"               # the register: one table row per file, first cell the `backticked` name
scope = [["tests/expected", ""], ["tests/expect", "expect/"]]   # [dir, row prefix]: the FILES directly under each
exclude = ["PROVENANCE.md"]
evidence_classes = ["in-emulator (reference)", "in-emulator (ours)", "in-emulator (reference + ours)",
                    "derived", "static", "hash-lock", "registry"]   # the CLOSED vocabulary of `rests on`
rests_on_column = 4

# --- slice H7: mapped fields at sync anchors + dump completeness (docs/config.md [fields]) ---
[fields]
table = "tests/fields_m2a.tsv"                      # name/base/addr/width[/phase[/note]]; `# base p1=0x…` headers override `bases`
dump_regex = '(?:^|\.)dump_(\d+)_([0-9a-fA-F]{6})\.bin$'
bases = { p1 = 0xFF8400, p2 = 0xFF8800 }           # a field's base column -> the address added to its addr
anchor = [[0xFF8004, 4, 0x40000], [0xFF8008, 4, 0x40000], [0xFF8450, 2, 0x120], [0xFF8850, 2, 0x120]]   # all true = match start
anchor_hint = "dump $FF8000-$FF8300 and $FF8400-$FF8C00 windows"
stable = 30                                         # the edge must hold this many frames
settle = 120                                        # `settled` fields join at this offset
integrity_hint = ["A glob-based comparison would have silently used a DIFFERENT",
                  "frame set. Do not compare this run — see docs/platform/gotchas.md."]
