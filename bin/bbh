#!/bin/sh
# bbh — the black-box harness's one entry point.
#
# Usage:
#   bbh run-static [args]         the pre-commit chain          (bin/bbh-run-static)
#   bbh classify <exit> <log>     one verdict                    (bin/bbh-classify)
#   bbh tier <bbh.toml> [--list|--unregistered]                  (lib/py/bbh/tier.py)
#   bbh config <bbh.toml> get <section.key> [--default V] | dump (lib/py/bbh/config.py)
#   bbh demand-after-trap <gates-dir> [--lib d] [--skip name]    (lib/py/bbh/demand_after_trap.py)
#   bbh compare-flicker | compare-window | compare-composite | check-diverge | describe-shape …
#                                 the comparison classes (lib/py/bbh/compare_*.py; H2)
#   bbh run-sweep [--config bbh.toml] [--scope|--lane|--cadence|--freeze|--only|--jobs|--timeout|--log|--resume|--strict|--keep-going|--dry-run|--list]
#                                 the instrument-tier sweep (bin/bbh-run-sweep; H4)
#   bbh run-suite [--config bbh.toml] [--driver d] [--freeze] [set]
#                                 the oracle replay suite (bin/bbh-run-suite; H3)
#   bbh fingerprint <rompath> [--set S] [--sha-only|--set-key|--full]   (lib/py/bbh/fingerprint.py; H3)
#   bbh rpl <replay.rpl>          lint a replay script (lib/py/bbh/rpl.py; H3)
#   bbh gate-index [--config bbh.toml] [--check|--stdout]   the GENERATED gate index (lib/py/bbh/gen_gate_index.py; H5)
#   bbh header-defaults [--config bbh.toml] [--fix]         a header names the default its code uses (H5)
#   bbh ref-rot [--config bbh.toml]                          a hard-coded path default has not rotted (H5)
#   bbh provenance [--config bbh.toml] [--page FILE]         every frozen expectation says where its numbers came from (H5)
#   bbh compare-fields <dir_a> <dir_b> --fields <tsv> [--exact|--follow …]   mapped fields at sync anchors (lib/py/bbh/compare_fields.py; H7)
#   bbh check-dumps <dir> --first F --last L | --contiguous              a dump set is complete (lib/py/bbh/check_dumps.py; H7)
#   bbh inp-play --set S --rompath "b;r" --inp <dir> [--out d]   play a MAME recording under the crash guard (H6)
#   bbh inp-corpus [--config bbh.toml] [--build d] [--only n]    every tracked recording, no exception (H6)
#   bbh check-skills [--config bbh.toml] [--root DIR] [-v]   a consumer's SKILLS locked to the docs they distil (lib/py/bbh/checkskills.py; H10)
#   bbh skill-guide [--config bbh.toml] [--check] [--prefix P] the GENERATED GUIDE.md beside a portable SKILL.md (H10)
#   bbh doctor [--config bbh.toml]  is this host able to run the harness?
#   bbh selftest                  the harness's own gate chain (selftest/run.sh)
#
# Every subcommand finds the harness from THIS file's location, so the
# harness can live anywhere; the consumer is found from --config / $BBH_CONFIG
# / ./bbh.toml. The MAME drivers (drivers/mame.sh, mame_guarded.sh, fbneo.sh)
# and the Lua layer under lua/mame/ are run by the suite, not dispatched here.
set -eu
BBH_HOME="$(cd "$(dirname "$0")/.." && pwd)"; export BBH_HOME
[ $# -ge 1 ] || { sed -n '2,28p' "$0"; exit 2; }
cmd="$1"; shift
PYTHONPATH="$BBH_HOME/lib/py${PYTHONPATH:+:$PYTHONPATH}"; export PYTHONPATH
case "$cmd" in
run-static)        exec "$BBH_HOME/bin/bbh-run-static" "$@" ;;
classify)          exec "$BBH_HOME/bin/bbh-classify" "$@" ;;
tier)              exec python3 -m bbh.tier "$@" ;;
config)            exec python3 -m bbh.config "$@" ;;
demand-after-trap) exec python3 -m bbh.demand_after_trap "$@" ;;
compare-flicker)   exec python3 -m bbh.compare_flicker "$@" ;;
compare-window)    exec python3 -m bbh.compare_window "$@" ;;
compare-composite) exec python3 -m bbh.compare_composite "$@" ;;
check-diverge)     exec python3 -m bbh.check_diverge "$@" ;;
describe-shape)    exec python3 -m bbh.describe_masked_shape "$@" ;;
run-sweep)         exec "$BBH_HOME/bin/bbh-run-sweep" "$@" ;;
run-suite)         exec "$BBH_HOME/bin/bbh-run-suite" "$@" ;;
fingerprint)       exec python3 -m bbh.fingerprint "$@" ;;
rpl)               exec python3 -m bbh.rpl "$@" ;;
gate-index)        exec python3 -m bbh.gen_gate_index "$@" ;;
header-defaults)   exec python3 -m bbh.header_defaults "$@" ;;
ref-rot)           exec python3 -m bbh.ref_rot "$@" ;;
provenance)        exec python3 -m bbh.provenance "$@" ;;
compare-fields)    exec python3 -m bbh.compare_fields "$@" ;;
check-dumps)       exec python3 -m bbh.check_dumps "$@" ;;
inp-play)          exec "$BBH_HOME/bin/bbh-inp-play" "$@" ;;
inp-corpus)        exec "$BBH_HOME/bin/bbh-inp-corpus" "$@" ;;
check-skills)      exec python3 -m bbh.checkskills "$@" ;;
skill-guide)       exec python3 -m bbh.gen_skill_guide "$@" ;;
doctor)            exec "$BBH_HOME/bin/bbh-doctor" "$@" ;;
selftest)          exec "$BBH_HOME/selftest/run.sh" "$@" ;;
-h|--help|help)    sed -n '2,28p' "$0"; exit 0 ;;
*) echo "bbh: unknown command '$cmd' (try bbh help)" >&2; exit 2 ;;
esac
