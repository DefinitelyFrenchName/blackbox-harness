#!/bin/sh
# bbh-doctor — can this host run the harness, and does the consumer config
# load? Prints one line per check; exits 1 on the first hard failure.
#
# Usage: bbh-doctor [--config bbh.toml]
set -eu
BBH_HOME="$(cd "$(dirname "$0")/.." && pwd)"; export BBH_HOME
. "$BBH_HOME/lib/sh/config.sh"
rc=0
ok()   { printf '  ok    %s\n' "$1"; }
note() { printf '  note  %s\n' "$1"; }
bad()  { printf '  FAIL  %s\n' "$1"; rc=1; }

echo "== bbh doctor =="
if command -v python3 >/dev/null 2>&1; then
    v="$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])')"
    case "$v" in 3.[0-7]|3.[0-7].*) bad "python3 $v — 3.8+ needed" ;; *) ok "python3 $v" ;; esac
    if python3 -c 'import tomllib' 2>/dev/null; then ok "tomllib present (the subset parser is cross-checked against it)"
    else note "no tomllib (python < 3.11): the subset parser runs unchecked on this host — selftest/test_config.sh reports its agreement section 'not run'"; fi
else
    bad "python3 not found"
fi
if command -v timeout >/dev/null 2>&1; then ok "timeout(1): $(command -v timeout)"
elif command -v gtimeout >/dev/null 2>&1; then ok "gtimeout(1): $(command -v gtimeout) (the sweep runner uses it)"
else note "no timeout(1): the sweep runner (H4) will run gates uncapped"; fi
command -v git >/dev/null 2>&1 && ok "git: $(git --version | head -1)" || note "no git: the working-tree snapshot is skipped"
_lua=""; for _l in lua lua5.4 lua5.3 luajit; do command -v "$_l" >/dev/null 2>&1 && { _lua="$_l"; break; }; done
[ -n "$_lua" ] && ok "lua: $(command -v "$_lua") (the .rpl parser equality selftest runs)" || note "no standalone lua (lua/lua5.4/lua5.3/luajit): selftest/test_rpl_lua.sh SKIPs; the parse is still proved under MAME by fidelity F8"
if [ -n "${MAME_BIN:-}" ]; then [ -x "$MAME_BIN" ] && ok "MAME_BIN: $MAME_BIN" || bad "MAME_BIN is not executable: $MAME_BIN"
elif command -v mame >/dev/null 2>&1; then note "MAME_BIN unset: drivers/mame.sh will run $(command -v mame) — a consumer with a pinned build must set it"
else note "no MAME (MAME_BIN unset, none on PATH): the MAME drivers cannot run here"; fi
[ -n "${FBNEO_BIN:-}" ] && { [ -x "$FBNEO_BIN" ] && ok "FBNEO_BIN: $FBNEO_BIN" || bad "FBNEO_BIN is not executable: $FBNEO_BIN"; } || note "FBNEO_BIN unset: drivers/fbneo.sh needs it"
sh -c ': "${BBH_DOCTOR_PROBE:?probe}"' >/dev/null 2>&1 && bad "sh accepted an unset demand" || ok "sh refuses an unset \${VAR:?} demand (exit $?)"

CONFIG="${2:-}"
[ "${1:-}" = "--config" ] && CONFIG="$2"
if [ -n "$CONFIG" ] || [ -f "${BBH_CONFIG:-bbh.toml}" ]; then
    bbh_config_init "$CONFIG"
    if python3 -m bbh.config "$BBH_CONFIG" dump >/dev/null 2>"$BBH_HOME/.doctor_err"; then
        ok "config loads: $BBH_CONFIG"
    else
        bad "config does not load: $(cat "$BBH_HOME/.doctor_err")"
    fi
    rm -f "$BBH_HOME/.doctor_err"
    g="$(bbh_cfg project.gates_dir)"
    [ -d "$BBH_ROOT/$g" ] && ok "gates dir: $g" || bad "gates dir '$g' not found under $BBH_ROOT"
    d="$(bbh_cfg suite.driver)"
    case "$d" in */*) case "$d" in /*) ;; *) d="$BBH_ROOT/$d" ;; esac ;; *) d="$BBH_HOME/drivers/$d.sh" ;; esac
    [ -x "$d" ] && ok "suite driver: $d" || bad "suite driver '$d' is not executable ([suite].driver; drivers/README.md)"
    r="$(bbh_cfg suite.registry)"
    [ -f "$BBH_ROOT/$r" ] && ok "registry: $r ($(grep -vc '^#' "$BBH_ROOT/$r" | tr -d ' ') rows)" || note "no registry at $r yet (the suite writes nothing there; rows are added at freeze time)"
else
    note "no config given and no ./bbh.toml — consumer checks skipped"
fi
[ "$rc" = 0 ] && echo "PASS" || echo "FAIL"
exit $rc
