#!/bin/sh
# bbh-run-static — THE PRE-COMMIT GATE CHAIN of a consumer project. One
# command, every gate that does not need an instrument (an emulator, a
# simulator, a driver).
#
# Lineage: VampireSaved's tests/run_all_static.sh (14z-94, GitHub #30 there).
# WHY IT EXISTS: a suite nobody invokes cannot halt forward work. That project
# had no CI and 101 of its 130 gates had no shell caller; one of them sat RED
# for 11 days while the law cited it as a guarantee. Automated here is the
# instrument-free set — the gates cheap enough to run before every commit.
#
# THREE VERDICTS, AND SKIP IS NOT PASS. A gate whose inputs are absent prints
# `SKIP: <reason>` and exits 0. Counting that as a pass is how a clean
# checkout reports green while asserting nothing, so SKIP is counted and
# printed separately, and `--strict` makes it fatal. The classifier is
# lib/sh/classify.sh, one copy for every runner.
#
# Usage:
#   bbh-run-static [--config bbh.toml]        portable tier only (no inputs)
#   <NEEDS_ENV>=... bbh-run-static            portable + static tiers
#   ... --strict                              SKIP is a failure too
#   ... --list                                print the registry and exit
#   ... --tier portable|static                one tier only
#   ... --exec-controls all|portable|none    which tier's declared must-fire
#                                            controls are EXECUTED (default all)
#
# THE MUST-FIRE CONTROLS ARE READ AND EXECUTED (docs/gate_contract.md §5).
# Two things, both through lib/sh/controls.sh — the one reader of the
# `# MUST-FIRE:` grammar:
#   READ  (free, every gate): a gate whose header DECLARES a control must
#         print `CONTROL FIRED: <name>` in its run; a declared control that
#         did not fire, a `CONTROL DEAD:` line, or a firing no header declares
#         turns the verdict into plain FAIL (lib/sh/classify.sh). A gate
#         with no declaration is COUNTED as undeclared, never failed.
#   EXEC  (one extra run per declared control, `CONTROL=<name> <gate>`):
#         the gate applies the perturbation to its REAL input and must reach
#         its OWN FAIL — HONOURED; exit 0 is LIES, a `REFUSED:` line is a dead
#         mode, a crash is DIED. Every non-HONOURED row is a failure of the
#         run, named `<gate>(control:<name>:<verdict>)`. `--exec-controls
#         none` is the developer's iteration knob; the default executes all,
#         because a lying control must not pass a pre-commit.
# Lineage: VampireSaved's run_all_static.sh, 14z-147.
#
# The config names the gates dir and the two registries ([registries]
# portable / static), and `static_needs_env` — the variable (default ROMDIR)
# whose presence enables the static tier. A gate that is instrument-free and
# in NEITHER registry is reported as UNREGISTERED — that check is the actual
# anti-orphan mechanism (lib/py/bbh/tier.py), and without it this script
# would simply become a new, smaller thing to forget to update.
set -eu
BBH_HOME="$(cd "$(dirname "$0")/.." && pwd)"; export BBH_HOME
. "$BBH_HOME/lib/sh/config.sh"
. "$BBH_HOME/lib/sh/classify.sh"
. "$BBH_HOME/lib/sh/registry.sh"

CONFIG=""; STRICT=0; TIER=all; LIST=0; EXEC_CTL=all
while [ $# -gt 0 ]; do
    case "$1" in
    --config) shift; CONFIG="${1:?--config needs a file}" ;;
    --strict) STRICT=1 ;;
    --list)   LIST=1 ;;
    --tier)   shift; TIER="${1:?--tier needs portable|static|all}" ;;
    --exec-controls) shift; EXEC_CTL="${1:?--exec-controls needs all|portable|none}" ;;
    -h|--help) sed -n '2,40p' "$0"; exit 0 ;;
    *) echo "unknown argument '$1' (try --help)" >&2; exit 2 ;;
    esac
    shift
done

bbh_config_init "$CONFIG"
bbh_classify_env
GATES_DIR="$(bbh_cfg project.gates_dir)"
REG_PORTABLE="$(bbh_cfg registries.portable)"
REG_STATIC="$(bbh_cfg registries.static)"
NEEDS_ENV="$(bbh_cfg registries.static_needs_env "")"
WORD="$(bbh_cfg project.instrument_word)"

# The input variable must be ABSOLUTE for the gates: a gate that resolves it
# from a DIFFERENT working directory than the caller's (a symlink into it from
# a temp dir, an overlay it cd's into) dangles on a relative path. Measured in
# the lineage: 2 of 3 "failures" that looked like a broken suite. Canonicalise
# at the entrance, BEFORE the cd below, so the documented pre-commit command
# is robust to how the caller spells it.
if [ -n "$NEEDS_ENV" ]; then
    eval "_needs_val=\${$NEEDS_ENV:-}"
    if [ -n "$_needs_val" ]; then
        _abs="$(CDPATH= cd "$_needs_val" && pwd)" || {
            echo "$NEEDS_ENV '$_needs_val' does not resolve from $(pwd)" >&2; exit 2; }
        eval "$NEEDS_ENV=\"\$_abs\""
        export "$NEEDS_ENV"
    fi
fi
cd "$BBH_ROOT"

PORTABLE="$(bbh_read_reg "$REG_PORTABLE")"
STATIC="$(bbh_read_reg "$REG_STATIC")"

if [ "$LIST" = 1 ]; then
    echo "portable ($(bbh_count "$PORTABLE")):"
    printf '%s\n' "$PORTABLE" | awk 'NF{print "  " $0}'
    echo "static ($(bbh_count "$STATIC")):"
    printf '%s\n' "$STATIC" | awk 'NF{print "  " $0}'
    exit 0
fi

WORK="$(mktemp -d)"; trap 'rm -rf "$WORK"' EXIT INT TERM
# A FAILING GATE'S FULL LOG SURVIVES THE RUN. $WORK is a mktemp dir the EXIT
# trap deletes, so without this a red prints its last few lines and the rest
# goes with it — and `FAIL: see above` is often exactly what those lines are.
# Paid for in the lineage twice (a fidelity gate red inside the tier and green
# alone, with no surviving evidence both times) before the capability existed.
# The path is RELATIVE to the runner's working directory, so a self-test that
# drives this runner from a throwaway root writes its DELIBERATE failures
# there and never into a shared evidence path. Only the current run's logs are
# kept: stale ones reading as current is the same trap in a different hat.
KEEP="${BBH_FAIL_LOGS:-${BBH_CLASSIFY_FAIL_LOGS:-build/gate_failures_static}}"
rm -f "$KEEP"/*.log 2>/dev/null || true
keep_log() {  # keep_log <gate> — preserve the full output, and say where
    if mkdir -p "$KEEP" 2>/dev/null && cp "$WORK/$1.out" "$KEEP/$1.log" 2>/dev/null; then
        printf '        | (full log: %s)\n' "$KEEP/$1.log"
    fi
}
n_pass=0; n_skip=0; n_fail=0; n_miss=0
failed=""; skipped=""
# the controls ledger: declared / fired over the tier, the undeclared count,
# and the executable-control rows (gate, name, verdict, seconds)
c_decl=0; c_fired=0; c_undecl=0; c_none=0
x_ok=0; x_lies=0; x_refused=0; x_died=0
: > "$WORK/controls.tsv"

# WORKING-TREE SNAPSHOT. This is the PRE-COMMIT command, so it must not leave
# the tree dirty — and in the lineage it did on the first full run: gates
# built into tracked paths rather than a temp dir. A pre-commit check whose
# own side effect is a diff will get its output ignored, so the run reports
# it. Reported, not failed: the gates are correct, their output location is
# not, and that is its own fix.
tree_before=""
if git rev-parse --git-dir >/dev/null 2>&1; then
    tree_before="$(git status --porcelain -- . 2>/dev/null | grep -v '^??' || true)"
fi

run_tier() {  # run_tier <label> <names>
    _label="$1"; _names="$2"
    [ -n "$_names" ] || return 0
    echo "== $_label tier =="
    for g in $_names; do
        if [ ! -x "$GATES_DIR/$g.sh" ]; then
            printf '  %-34s %s\n' "$g" "MISSING (registered but not executable)"
            n_miss=$((n_miss + 1)); failed="$failed $g(missing)"
            continue
        fi
        _t0=$(date +%s)
        # </dev/null: a gate that reads stdin otherwise swallows the rest of
        # this loop's input. Paid for once — a 32-entry run became 28 silently.
        "$GATES_DIR/$g.sh" </dev/null > "$WORK/$g.out" 2>&1 && _st=0 || _st=$?
        _t1=$(date +%s)
        _dur=$((_t1 - _t0))
        # the 4th argument is the gate SCRIPT: the classifier reads its
        # MUST-FIRE declarations against the log
        bbh_classify "$_st" "$WORK/$g.out" 58 "$GATES_DIR/$g.sh"
        case "${BBH_CTL_VERDICT:-}" in
        OK|RED)     c_decl=$((c_decl + BBH_CTL_DECLARED)); c_fired=$((c_fired + BBH_CTL_FIRED)) ;;
        NONE)       c_none=$((c_none + 1)) ;;
        UNDECLARED) if [ "$BBH_VERDICT" = PASS ]; then c_undecl=$((c_undecl + 1)); fi ;;
        esac
        case "$BBH_VERDICT" in
        TIMEOUT)
            printf '  %-34s TIMEOUT %3ss  (exit %s)\n' "$g" "$_dur" "$_st"
            keep_log "$g"
            n_fail=$((n_fail + 1)); failed="$failed $g" ;;
        FAIL)
            if [ "$_st" != 0 ]; then
                printf '  %-34s FAIL  %3ss  (exit %s)\n' "$g" "$_dur" "$_st"
            elif [ "${BBH_CTL_VERDICT:-}" = RED ]; then
                # a controls red on an exit-0 run: say so, not "shell error"
                printf '  %-34s FAIL  %3ss  (%s)\n' "$g" "$_dur" "$BBH_DETAIL"
            else
                printf '  %-34s FAIL  %3ss  (exit 0 after a shell error)\n' "$g" "$_dur"
            fi
            # FAIL_TAIL: how much of a failing gate's output to show (default
            # from the config; a red read remotely needs the section that
            # failed, not the last four lines of its controls).
            tail -"${FAIL_TAIL:-${BBH_CLASSIFY_FAIL_TAIL:-4}}" "$WORK/$g.out" | sed 's/^/        | /'
            keep_log "$g"
            n_fail=$((n_fail + 1)); failed="$failed $g" ;;
        SKIP)
            printf '  %-34s SKIP  %3ss  %s\n' "$g" "$_dur" "$BBH_DETAIL"
            n_skip=$((n_skip + 1)); skipped="$skipped $g" ;;
        *)
            printf '  %-34s PASS  %3ss\n' "$g" "$_dur"
            n_pass=$((n_pass + 1))
            # an `if`, not `[ ] &&`: this is the loop's last command and the
            # runner is set -e — a false test here would end the tier
            if [ "${BBH_CTL_DECLARED:-0}" != 0 ]; then exec_controls "$g" "$_label"; fi ;;
        esac
    done
}

# EXECUTABLE CONTROLS. For a PASSING gate with declarations, run it once per
# declared name under `CONTROL=<name>` and require its OWN FAIL. The verdicts
# (lib/sh/classify.sh, bbh_classify_control): HONOURED, LIES, REFUSED, DIED,
# TIMEOUT. Every row lands in the tally as a failure when it is not HONOURED.
exec_controls() {  # exec_controls <gate> <tier-label>
    case "$EXEC_CTL" in
    none) return 0 ;;
    portable) [ "$2" = portable ] || return 0 ;;
    all) ;;
    *) echo "bad --exec-controls '$EXEC_CTL'" >&2; exit 2 ;;
    esac
    for _n in $(bbh_ctl_declared "$GATES_DIR/$1.sh"); do
        _c0=$(date +%s)
        CONTROL="$_n" "$GATES_DIR/$1.sh" </dev/null > "$WORK/$1.ctl.$_n.out" 2>&1 && _cs=0 || _cs=$?
        _c1=$(date +%s); _cd=$((_c1 - _c0))
        bbh_classify_control "$_cs" "$WORK/$1.ctl.$_n.out"; _cv="$BBH_CTL_EXEC"
        printf '%s\t%s\t%s\t%s\n' "$1" "$_n" "$_cv" "$_cd" >> "$WORK/controls.tsv"
        case "$_cv" in
        HONOURED) x_ok=$((x_ok + 1)) ;;
        LIES)     x_lies=$((x_lies + 1)) ;;
        REFUSED)  x_refused=$((x_refused + 1)) ;;
        *)        x_died=$((x_died + 1)) ;;
        esac
        if [ "$_cv" != HONOURED ]; then
            n_fail=$((n_fail + 1)); failed="$failed $1(control:$_n:$_cv)"
            printf '  %-34s CONTROL %s: %s — %s (%ss)\n' "$1" "$_cv" "$_n" "$BBH_CTL_EXEC_DETAIL" "$_cd"
        fi
    done
}

static_enabled() {
    [ -z "$NEEDS_ENV" ] && return 0
    eval "_v=\${$NEEDS_ENV:-}"
    [ -n "$_v" ]
}

case "$TIER" in
portable) run_tier portable "$PORTABLE" ;;
static)   run_tier static   "$STATIC" ;;
all)
    run_tier portable "$PORTABLE"
    if static_enabled; then
        run_tier static "$STATIC"
    else
        echo "== static tier =="
        echo "  NOT RUN: $NEEDS_ENV is unset. These gates read the reference set or"
        echo "           a build dir. Set $NEEDS_ENV to include them."
        n_skip=$((n_skip + $(bbh_count "$STATIC")))
        skipped="$skipped <static-tier:$NEEDS_ENV-unset>"
    fi ;;
*) echo "bad --tier '$TIER'" >&2; exit 2 ;;
esac

echo
echo "== registry coverage (the anti-orphan check) =="
python3 -m bbh.tier "$BBH_CONFIG" --unregistered

echo
echo "== working tree (a pre-commit command must not dirty it) =="
if [ -z "$tree_before" ] && ! git rev-parse --git-dir >/dev/null 2>&1; then
    echo "  note: not a git checkout — not checked"
else
    tree_after="$(git status --porcelain -- . 2>/dev/null | grep -v '^??' || true)"
    if [ "$tree_before" = "$tree_after" ]; then
        echo "  ok: no tracked file changed during the run"
    else
        # Diff via files: `grep -vxF "$multiline"` treats the string as a
        # pattern LIST and a blank line in it matches everything.
        printf '%s\n' "$tree_before" | awk 'NF' > "$WORK/tree_before.txt"
        printf '%s\n' "$tree_after"  | awk 'NF' > "$WORK/tree_after.txt"
        echo "  DIRTIED by the run — these gates write into TRACKED paths"
        echo "  instead of a temp dir; restore with 'git checkout --' on them:"
        diff "$WORK/tree_before.txt" "$WORK/tree_after.txt" \
            | grep '^[<>]' | sed 's/^/      /' | head -12
        echo "      (before: $(wc -l < "$WORK/tree_before.txt" | tr -d ' ') entries," \
             "after: $(wc -l < "$WORK/tree_after.txt" | tr -d ' '))"
    fi
fi

# NOTE-class numbers: a measurement a gate REPORTS but never gates on. A
# verdict is per GATE; a NOTE is per NUMBER, and one gate can report several,
# so this is deliberately NOT a fifth verdict in lib/classify.sh - that would
# have to reach every runner and its ground truth. The convention: a gate
# prints `NOTE: <key> <value>` at column 0, exits 0 with its usual PASS, and
# this block surfaces it. A number moving the wrong way is the signal.
echo
echo "== NOTE-class numbers (reported, never fatal) =="
_notes=0
for _f in "$WORK"/*.out; do
    [ -f "$_f" ] || continue
    _g="$(basename "$_f" .out)"
    while IFS= read -r _line; do
        # an EMPTY command substitution still feeds `read` one blank line
        [ -n "$_line" ] || continue
        printf '  %-34s %s\n' "$_g" "${_line#NOTE: }"
        _notes=$((_notes + 1))
    done <<EOF
$(grep '^NOTE: ' "$_f" 2>/dev/null || true)
EOF
done
[ "$_notes" = 0 ] && echo "  (none)"

# THE CONTROLS READOUT. `fired / declared` is the number a maintainer asks
# for; the executable rows are what makes FIRED more than a self-report.
# Undeclared gates are a NOTE-class count (a consumer's grammar may postdate
# most of its suite); a red control is already in the tally above. Printed
# only when the tier DECLARED or EXECUTED anything: a tree with no
# `# MUST-FIRE:` line prints nothing here, so a consumer that has not adopted
# the grammar sees the runner it always had, byte for byte.
_xn=$((x_ok + x_lies + x_refused + x_died))
if [ $((c_decl + c_none + _xn)) != 0 ]; then
echo
echo "== must-fire controls =="
echo "  read:     fired $c_fired / declared $c_decl  (gates declaring none: $c_none; undeclared: $c_undecl)"
if [ "$EXEC_CTL" = none ]; then
    echo "  executed: (off — --exec-controls none)"
else
    echo "  executed: $_xn  honoured $x_ok  lies $x_lies  refused $x_refused  died $x_died  (--exec-controls $EXEC_CTL)"
    awk -F'\t' '$3 != "HONOURED" {printf "      %-30s %-24s %s\n", $1, $2, $3}' "$WORK/controls.tsv"
fi
fi

echo
echo "======================================================================"
printf 'PASS %-4s  SKIP %-4s  FAIL %-4s  MISSING %s\n' \
    "$n_pass" "$n_skip" "$n_fail" "$n_miss"
[ -n "$skipped" ] && echo "skipped:$skipped"
[ -n "$failed" ]  && echo "failed: $failed"

rc=0
[ "$n_fail" = 0 ] && [ "$n_miss" = 0 ] || rc=1
if [ "$STRICT" = 1 ] && [ "$n_skip" != 0 ]; then
    echo "--strict: SKIP counts as failure (a skipped gate asserts NOTHING)"
    rc=1
fi
[ "$rc" = 0 ] && echo "GREEN — every registered $WORD-free gate passed." \
              || echo "NOT GREEN — see above. Rule 6: fixing this is the only task."
exit $rc
